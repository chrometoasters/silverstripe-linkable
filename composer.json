{
    "name": "sheadawson/silverstripe-linkable",
    "type": "silverstripe-vendormodule",
    "description": "A couple of handy form fields and objects for managing external and internal links on DataObjects (Chrometoaster fork for Silverstripe CMS 6)",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "cms",
        "link"
    ],
    "homepage": "http://github.com/sheadawson/silverstripe-linkable",
    "authors": [
        {
            "name": "Shea Dawson",
            "email": "shea@silverstripe.com.au"
        },
        {
            "name": "Marcus Nyeholt",
            "email": "marcus@silverstripe.com.au"
        }
    ],
    "support": {
        "issues": "https://github.com/chrometoasters/silverstripe-linkable/issues"
    },
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "unclecheese/display-logic": "^4",
        "embed/embed": "^4.4"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "silverstripe/cms": "^6"
    },
    "autoload": {
        "psr-4": {
            "Sheadawson\\Linkable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sheadawson\\Linkable\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "silverstripe/cms": "To allow for a linking of the SiteTree data object.",
        "silverstripe/admin": "The LinkField and EmbeddedObjectField dialogs use the jQuery, jQuery UI and entwine libraries bundled with the CMS admin."
    },
    "extra": {
        "installer-name": "linkable",
        "branch-alias": {
            "dev-ss6": "3.0.x-dev",
            "dev-master": "3.0.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
