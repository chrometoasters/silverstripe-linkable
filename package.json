{
  "name": "silverstripe-linkable",
  "version": "2.0.0",
  "description": "Manage adding links to websites and media in Silverstripe",
  "directories": {
  },
  "bin": {
    "webpack": "./node_modules/webpack/webpack.js"
  },
  "engines": {
    "node": "^24.x"
  },
  "scripts": {
    "build": "yarn && NODE_ENV=production webpack --mode production --bail --progress",
    "dev": "NODE_ENV=development webpack --mode development --progress",
    "watch": "NODE_ENV=development webpack --mode development --watch --progress",
    "css": "WEBPACK_CHILD=css npm run build",
    "lint": "eslint client/src && stylelint client/src",
    "js-fix": "eslint client/src --fix"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sheadawson/silverstripe-linkable.git"
  },
  "keywords": [
    "silverstripe",
    "module"
  ],
  "author": "Uncle Cheese",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/sheadawson/silverstripe-linkable/issues"
  },
  "homepage": "https://github.com/sheadawson/silverstripe-linkable/",
  "devDependencies": {
    "@silverstripe/eslint-config": "^2",
    "@silverstripe/webpack-config": "^3",
    "eslint": "^8.26.0",
    "stylelint": "~16.12.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "yarn@1.22.22"
}
